# ─────────────────────────────────────────────────────────────
# WhatsApp delivery for the contact form
# Pick ONE provider: "callmebot" (simplest) or "cloud" (Meta WhatsApp Cloud API).
# Leave WHATSAPP_PROVIDER empty and the form falls back to opening
# WhatsApp on the visitor's phone with the enquiry pre-filled.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional, for testing: send form enquiries to another WhatsApp number (international format).
# Leave empty in production so enquiries go to the business number in lib/content.ts.
NEXT_PUBLIC_ENQUIRY_WHATSAPP=

WHATSAPP_PROVIDER=callmebot

# Option A: CallMeBot (free, sends to your own WhatsApp number)
# Number in international format, no + or spaces
CALLMEBOT_PHONE=923321788788
CALLMEBOT_APIKEY=

# Option B: Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=923321788788
WHATSAPP_API_VERSION=v21.0
# Approved template with ONE body variable {{1}} (needed for business-initiated messages)
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
